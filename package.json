{
  "name": "taxi-copilot-architecture",
  "private": true,
  "version": "1.5.0-showcase",
  "description": "Taxi Copilot · Showcase Edition — PWA de Apoio Operacional, Inteligência Geoespacial e Controle Financeiro para Mobilidade Urbana (Rio de Janeiro)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:https": "vite --host --mode https",
    "build": "tsc --noEmit && vite build",
